 from __future__ import annotations
 
+import itertools
 import queue
 import threading
+import time
 from typing import Any, Callable
 
 from .streams import Stream
 
 
+def _mem_available_gib() -> float:
+    """The host's MemAvailable (the GPU's memory too, on a unified-memory board such as Thor), or -1."""
+
+    try:
+        with open("/proc/meminfo") as f:
+            for line in f:
+                if line.startswith("MemAvailable:"):
+                    return int(line.split()[1]) / 2**20
+    except (OSError, ValueError):
+        pass
+    return -1.0
+
+
+def _log(rid: int | str, text: str) -> None:
+    """One line a request event, flushed at once: after a GPU hang the last lines say what was running."""
+
+    print(f"[tensorfold] {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} req {rid} {text}", flush=True)
+
